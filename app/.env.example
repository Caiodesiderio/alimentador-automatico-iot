# =====================================================================
# MODELO de configuração. Este arquivo VAI para o Git.
# =====================================================================
# Copie para ".env" e preencha com os valores reais:
#
#   cp .env.example .env
#
# O ".env" está no .gitignore e nunca deve ser versionado.
#
# Onde achar: Supabase > Project Settings > API
# =====================================================================

# Project URL. Sem barra no final.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Chave "anon public".
#
# Ela é pública por natureza: vai embutida no bundle que o navegador
# baixa, e não há como escondê-la num app de front-end. Quem protege os
# dados é a RLS do banco. Por isso a chave "service_role" NUNCA entra
# aqui — ela ignora a RLS e daria acesso total a quem abrir o código.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Id do alimentador, igual ao da tabela devices.
VITE_DEVICE_ID=esp32-01

# Nome mostrado na saudação da tela de Início.
VITE_TUTOR_NOME=Caio
